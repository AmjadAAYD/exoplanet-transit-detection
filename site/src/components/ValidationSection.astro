---
import validationData from "../data/validation.json";

const bySystem: Record<string, typeof validationData> = {};
for (const row of validationData) {
  (bySystem[row.system] ??= []).push(row);
}
const summary = [
  { system: "TRAPPIST-1", recovered: 6, total: 7 },
  { system: "Kepler-90", recovered: 6, total: 8 },
  { system: "Kepler-186", recovered: 5, total: 5 },
];
---

<section class="section" id="validation">
  <div class="wrap">
    <p class="kicker">Step 1: reproduce known discoveries</p>
    <h2>Recovering real planets from raw photometry</h2>
    <p>
      Before pointing this at anything unknown, it has to find planets we already know are there. Three
      systems, raw K2/Kepler light curves, the same classical Box Least Squares search astronomers use, no
      shortcuts.
    </p>

    <div class="stat-row">
      {summary.map((s) => (
        <div class="stat">
          <span class="stat-num">{s.recovered}<span class="stat-den">/{s.total}</span></span>
          <span class="stat-label">{s.system}</span>
        </div>
      ))}
    </div>

    {Object.entries(bySystem).map(([system, rows]) => (
      <div class="system-block">
        <h3>{system}</h3>
        <table>
          <thead>
            <tr>
              <th>Planet</th>
              <th class="num">Published (d)</th>
              <th class="num">Recovered (d)</th>
              <th class="num">Error</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.planet}</td>
                <td class="num">{r.published_period_days.toFixed(6)}</td>
                <td class="num">{r.recovered_period_days ? r.recovered_period_days.toFixed(6) : "–"}</td>
                <td class="num">{r.error_percent !== null && r.error_percent !== undefined ? `${r.error_percent > 0 ? "+" : ""}${r.error_percent}%` : "–"}</td>
                <td>
                  {r.matched ? (
                    <span class="mark mark-good">✓ recovered</span>
                  ) : (
                    <span class="mark mark-bad">✗ not recovered</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}

    <p class="note">
      TRAPPIST-1 f, and Kepler-90 g and h were not recovered, most likely noise or aliasing after the
      stronger signals in each system were masked out during the iterative search. Reported as misses, not
      hidden. Full data: <a href="https://github.com/AmjadAAYD/exoplanet-transit-detection/blob/main/docs/validation_table.csv">validation_table.csv</a>.
    </p>
  </div>
</section>

<style>
  .stat-row {
    display: flex;
    gap: 56px;
    margin: 40px 0 48px;
    flex-wrap: wrap;
  }
  .system-block { margin-bottom: 40px; }
  .system-block h3 { margin-bottom: 14px; font-style: italic; }
  .note { font-size: 0.95rem; margin-top: 28px; color: var(--ink-dim); }

  @media (max-width: 560px) {
    .stat-row { gap: 32px; }
  }
</style>
